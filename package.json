{
  "name": "soniox-live-subs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Xem video (URL / local) với phụ đề Real-time và dịch Real-time bằng Soniox WebSocket STT, UI tối ưu cho iPhone.",
  "scripts": {
    "dev": "tsx server.ts",
